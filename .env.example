# EGH490-1 FollowNet + ChatSUMO — environment variables
# Copy this file to ".env" and fill in real values once you have them.
# Only needed for the ChatSUMO tab (chatsumo/llm_backend.py) — the
# Simulation tab and run_experiment.py use the hardcoded presets in
# sim/configs.py and never call this key.

# Anthropic API key, used by chatsumo/llm_backend.py::elicit_idm_params_claude()
# Get one at: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — only if you're running the local Ollama/Llama 3.1 backend instead
# of the Claude API (see llm_backend.py::elicit_idm_params_ollama)
# OLLAMA_HOST=http://localhost:11434
